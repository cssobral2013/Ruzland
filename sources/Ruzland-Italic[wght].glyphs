{
code = "#> classes
#/> otclasses
@locl = [Elcyr Decyr vecyr zhecyr yucyr kacyr Efcyr efcyr decyr elcyr zecyr];
@locl2 = [Elcyr.loclBGR Decyr.loclBGR vecyr.loclBGR zhecyr.loclBGR yucyr.loclBGR kacyr.loclBGR Efcyr.loclBGR efcyr.loclBGR decyr.loclBGR elcyr.loclBGR zecyr.loclBGR];
#/< otclasses
#< classes

###
# OpenType Layout feature definitions
# Format: Adobe FDK for OpenType (AFDKO) version 2.5
# Generated on: 2025-3-29 14:20
# Generated by: FontLab 8.0.0
# Font PostScript name: PTAstraSans-Italic
